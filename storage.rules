rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'raywu02070209@gmail.com';
    }
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
