rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'raywu02070209@gmail.com';
    }
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
